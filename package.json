{
  "name": "boquitas659",
  "version": "1.0.0",
  "description": "Plantilla base para proyectos Node/TypeScript con Claude Code en VS Code: flujo spec-driven y seguridad en capas.",
  "main": "dist/src/index.js",
  "directories": {
    "doc": "docs"
  },
  "scripts": {
    "test": "vitest run",
    "test:integration": "vitest run --project integration",
    "lint": "eslint .",
    "typecheck": "tsc --noEmit",
    "build": "tsc -p tsconfig.build.json && node scripts/copy-assets.mjs",
    "dev": "npm run build && node dist/src/index.js",
    "migrate": "node dist/src/db/migrate-cli.js",
    "jobs:outbox": "node dist/src/jobs/outbox.js",
    "jobs:cleanup": "node dist/src/jobs/cleanup.js",
    "support:create": "node dist/scripts/create-support-user.js",
    "report:email": "node dist/scripts/email-delivery-report.js",
    "legal:publish": "node dist/scripts/publish-legal-document.js",
    "format": "prettier --write \"src/**/*.ts\" \"tests/**/*.ts\" \"scripts/**/*.ts\""
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/jmralcala/boquitas659.git"
  },
  "keywords": [],
  "author": "",
  "license": "ISC",
  "type": "module",
  "bugs": {
    "url": "https://github.com/jmralcala/boquitas659/issues"
  },
  "homepage": "https://github.com/jmralcala/boquitas659#readme",
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@types/node": "^26.6.6",
    "@types/nodemailer": "^8.0.2",
    "eslint": "^10.15.0",
    "prettier": "^3.10.1",
    "typescript": "^6.0.3",
    "typescript-eslint": "^8.73.0",
    "vitest": "^5.1.1"
  },
  "dependencies": {
    "@fastify/cookie": "^11.1.5",
    "@fastify/formbody": "^9.0.2",
    "@fastify/helmet": "^13.2.0",
    "@fastify/multipart": "^10.1.9",
    "@fastify/rate-limit": "^11.3.0",
    "argon2": "^0.45.2",
    "bcryptjs": "^3.0.3",
    "fastify": "^5.12.8",
    "mysql2": "^3.24.6",
    "nodemailer": "^10.6.1",
    "otplib": "^13.6.0",
    "zod": "^4.6.7"
  }
}
